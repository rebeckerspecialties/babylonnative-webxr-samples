<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM"/>
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00401000" android:required="true"/>
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true"/>
    <application android:allowBackup="false" android:label="WebXR WebGPU Samples" android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity android:name=".SampleActivity" android:exported="true" android:launchMode="singleTask"
                  android:screenOrientation="landscape" android:configChanges="orientation|keyboardHidden|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="com.oculus.intent.category.VR"/>
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
